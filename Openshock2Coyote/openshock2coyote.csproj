<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <SingleProject>true</SingleProject>
        <!-- net9.0-windows10.0.19041.0 pinned to 19041 (Windows 10 2004) specifically - earlier
             Windows SDK versions' WinRT Bluetooth LE projections don't work reliably with
             InTheHand.BluetoothLE. -->
        <TargetFrameworks>net9.0;net9.0-windows10.0.19041.0</TargetFrameworks>
        <!-- allows building/restoring the windows TFM's reference assemblies from Linux; we're
             only ever producing a hand-off artifact here, never running it on this machine. -->
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>openshock2coyote</RootNamespace>
        <Version>0.3.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>

        <Configurations>Release;Debug</Configurations>

        <Platforms>AnyCPU</Platforms>

        <PackageId>openshock2coyote</PackageId>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CircularBuffer" Version="1.4.0" />
      <PackageReference Include="InTheHand.BluetoothLE" Version="4.0.42" />
      <PackageReference Include="MudBlazor" Version="8.10.0" />
      <PackageReference Include="OpenShock.Desktop.ModuleBase" Version="1.0.0" />
      <PackageReference Include="OpenShock.SDK.CSharp" Version="0.0.39" />
      <PackageReference Include="OpenShock.SDK.CSharp.Live" Version="0.0.39" />
      <PackageReference Include="OpenShock.Serialization.Flatbuffers" Version="1.0.0" />
      <PackageReference Include="Semver" Version="3.0.0" />
      <PackageReference Include="Serilog" Version="4.3.0" />
      <PackageReference Include="System.Reactive" Version="6.0.1" />
    </ItemGroup>

    <ItemGroup>
        <_ContentIncludedByDefault Remove="wwwroot\images\Icon.svg" />
        <_ContentIncludedByDefault Remove="wwwroot\images\Icon512.png" />
        <_ContentIncludedByDefault Remove="wwwroot\images\Icon64.png" />
        <_ContentIncludedByDefault Remove="wwwroot\images\IconLoadingSpin.svg" />
        <_ContentIncludedByDefault Remove="wwwroot\images\IconSlowSpin.svg" />
        <_ContentIncludedByDefault Remove="Properties\launchSettings.json" />
    </ItemGroup>

    <ItemGroup>
        <UpToDateCheckInput Remove="Ui\Pages\Authentication\Authenticate.razor" />
        <UpToDateCheckInput Remove="Ui\Pages\Authentication\LoginPart.razor" />
        <UpToDateCheckInput Remove="Ui\Pages\Authentication\NotAuthedLayout.razor" />
        <UpToDateCheckInput Remove="Ui\ErrorHandling\CodeBlock.razor" />
        <UpToDateCheckInput Remove="Ui\ErrorHandling\ContainerWithExceptionHandling.razor" />
        <UpToDateCheckInput Remove="Ui\ErrorHandling\ExceptionView.razor" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Resources\openshock2coyote-Icon.png" />
        <EmbeddedResource Include="Resources\openshock2coyote-Icon.png" />
    </ItemGroup>

    <PropertyGroup>
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <!-- Needed so `dotnet build` (not just publish) copies package dependencies into $(TargetDir),
             which CopyOwnDllOnly below then sorts into the module's libs folder. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <Target Name="CopyOwnDllOnly" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
        <PropertyGroup>
            <ModuleDir>/home/luna/.config/OpenShock/Desktop/modules/openshock2coyote</ModuleDir>
            <!-- the linux host install is our only local reference for "already shipped, don't
                 duplicate" - it's the same app/dependency set across platforms, so this list is
                 reused as-is when sorting the windows build's dependencies too. -->
            <HostDir>/home/luna/Documents/Programs/OpenShock.Desktop.Photino.Linux</HostDir>

            <IsWindowsBuild>false</IsWindowsBuild>
            <IsWindowsBuild Condition="'$(TargetFramework)' == 'net9.0-windows10.0.19041.0'">true</IsWindowsBuild>

            <!-- this machine can't run a windows build, so it can't live in the module folder the
                 host actually loads from - it just gets packaged next to it for hand-off. -->
            <DeployDir Condition="'$(IsWindowsBuild)' != 'true'">$(ModuleDir)</DeployDir>
            <DeployDir Condition="'$(IsWindowsBuild)' == 'true'">$(ModuleDir)\win-x64-build</DeployDir>
        </PropertyGroup>

        <ItemGroup>
            <OwnDll Include="$(TargetPath)" />
            <OwnDll Include="$(TargetDir)$(TargetName).pdb" />

            <!-- dlls already shipped by the host process; no need (and no room) to duplicate them -->
            <HostDll Include="$(HostDir)\*.dll" />

            <!-- InTheHand.BluetoothLE resolves to a different backend per TFM: Linux/BlueZ (via
                 Linux.Bluetooth/Tmds.DBus) on plain net9.0, WinRT (via WinRT.Runtime) on the
                 windows-qualified TFM. Neither ships RID-specific "runtimes/" assets (confirmed
                 via the NuGet cache), so MSBuild can't detect this split on its own - it's called
                 out explicitly here. -->
            <PlatformDependentDllNames Include="InTheHand.BluetoothLE.dll" />
            <PlatformDependentDllNames Include="Linux.Bluetooth.dll" Condition="'$(IsWindowsBuild)' != 'true'" />
            <PlatformDependentDllNames Include="Tmds.DBus.dll" Condition="'$(IsWindowsBuild)' != 'true'" />
            <PlatformDependentDllNames Include="WinRT.Runtime.dll" Condition="'$(IsWindowsBuild)' == 'true'" />
            <PlatformDependentDllNames Include="Microsoft.Windows.SDK.NET.dll" Condition="'$(IsWindowsBuild)' == 'true'" />
            <PlatformDependentDll Include="@(PlatformDependentDllNames->'$(TargetDir)%(Identity)')" Condition="Exists('$(TargetDir)%(Identity)')" />

            <!-- everything else resolved into our output is a platform-agnostic dependency -->
            <DependencyDll Include="$(TargetDir)*.dll"
                            Exclude="$(TargetPath);@(HostDll->'$(TargetDir)%(Filename)%(Extension)');@(PlatformDependentDll)" />
        </ItemGroup>

        <ItemGroup Condition="'$(IsWindowsBuild)' != 'true'">
            <PlatformDependentDllDestFolder Include="$(DeployDir)\libs\linux-x64" />
        </ItemGroup>
        <ItemGroup Condition="'$(IsWindowsBuild)' == 'true'">
            <PlatformDependentDllDestFolder Include="$(DeployDir)\libs\win-x64" />
        </ItemGroup>

        <Copy SourceFiles="@(OwnDll)" DestinationFolder="$(DeployDir)" />
        <Copy SourceFiles="@(DependencyDll)" DestinationFolder="$(DeployDir)\libs" />
        <Copy SourceFiles="@(PlatformDependentDll)" DestinationFolder="@(PlatformDependentDllDestFolder)" />
    </Target>
</Project>
