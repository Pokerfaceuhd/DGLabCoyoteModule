<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- per-developer paths (ModuleDir/HostDir) - not committed, see local.settings.props.example -->
    <Import Project="local.settings.props" Condition="Exists('local.settings.props')" />

    <PropertyGroup>
        <SingleProject>true</SingleProject>
        <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>openshock2coyote</RootNamespace>
        <Version>0.4.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>

        <Configurations>Release;Debug</Configurations>

        <Platforms>AnyCPU</Platforms>

        <PackageId>openshock2coyote</PackageId>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CircularBuffer" Version="1.4.0" />
      <PackageReference Include="InTheHand.BluetoothLE" Version="4.0.44" />
      <PackageReference Include="MudBlazor" Version="9.2.0" />
      <PackageReference Include="OpenShock.Desktop.ModuleBase" Version="1.1.4" />
      <PackageReference Include="OpenShock.SDK.CSharp" Version="0.0.40" />
      <PackageReference Include="OpenShock.SDK.CSharp.Live" Version="0.0.40" />
      <PackageReference Include="OpenShock.Serialization.Flatbuffers" Version="2.1.0" />
      <PackageReference Include="Semver" Version="3.0.0" />
      <PackageReference Include="Serilog" Version="4.3.0" />
      <PackageReference Include="System.Reactive" Version="6.1.0" />
      <PackageReference Include="Tmds.DBus" Version="0.94.2" />
    </ItemGroup>

    <ItemGroup>
        <_ContentIncludedByDefault Remove="wwwroot\images\Icon.svg" />
        <_ContentIncludedByDefault Remove="wwwroot\images\Icon512.png" />
        <_ContentIncludedByDefault Remove="wwwroot\images\Icon64.png" />
        <_ContentIncludedByDefault Remove="wwwroot\images\IconLoadingSpin.svg" />
        <_ContentIncludedByDefault Remove="wwwroot\images\IconSlowSpin.svg" />
        <_ContentIncludedByDefault Remove="Properties\launchSettings.json" />
    </ItemGroup>

    <ItemGroup>
        <UpToDateCheckInput Remove="Ui\Pages\Authentication\Authenticate.razor" />
        <UpToDateCheckInput Remove="Ui\Pages\Authentication\LoginPart.razor" />
        <UpToDateCheckInput Remove="Ui\Pages\Authentication\NotAuthedLayout.razor" />
        <UpToDateCheckInput Remove="Ui\ErrorHandling\CodeBlock.razor" />
        <UpToDateCheckInput Remove="Ui\ErrorHandling\ContainerWithExceptionHandling.razor" />
        <UpToDateCheckInput Remove="Ui\ErrorHandling\ExceptionView.razor" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Resources\openshock2coyote-Icon.png" />
        <EmbeddedResource Include="Resources\openshock2coyote-Icon.png" />
    </ItemGroup>

    <PropertyGroup>
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <Target Name="CopyOwnDllOnly" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
        <Warning Text="ModuleDir/HostDir not set - copy local.settings.props.example to local.settings.props and fill in your paths. Skipping local module deployment for this build."
                 Condition="'$(ModuleDir)' == '' or '$(HostDir)' == ''" />

        <PropertyGroup>
            <IsWindowsBuild>false</IsWindowsBuild>
            <IsWindowsBuild Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">true</IsWindowsBuild>

            <PlatformLibsDir Condition="'$(IsWindowsBuild)' != 'true'">$(ModuleDir)\libs\linux-x64</PlatformLibsDir>
            <PlatformLibsDir Condition="'$(IsWindowsBuild)' == 'true'">$(ModuleDir)\libs\win-x64</PlatformLibsDir>
        </PropertyGroup>

        <ItemGroup Condition="'$(ModuleDir)' != '' and '$(HostDir)' != ''">
            <OwnDll Include="$(TargetPath)" />
            <OwnDll Include="$(TargetDir)$(TargetName).pdb" />

            <HostDll Include="$(HostDir)\*.dll" />

            <PlatformDependentDllNames Include="InTheHand.BluetoothLE.dll" />
            <PlatformDependentDllNames Include="Linux.Bluetooth.dll" Condition="'$(IsWindowsBuild)' != 'true'" />
            <PlatformDependentDllNames Include="Tmds.DBus.dll" Condition="'$(IsWindowsBuild)' != 'true'" />
            <PlatformDependentDllNames Include="WinRT.Runtime.dll" Condition="'$(IsWindowsBuild)' == 'true'" />
            <PlatformDependentDllNames Include="Microsoft.Windows.SDK.NET.dll" Condition="'$(IsWindowsBuild)' == 'true'" />
            <PlatformDependentDll Include="@(PlatformDependentDllNames->'$(TargetDir)%(Identity)')" Condition="Exists('$(TargetDir)%(Identity)')" />
            <UselessDllNames Include="Tmds.DBus.dll" Condition="'$(IsWindowsBuild)' == 'true'" />
            <UselessDll Include="@(UselessDllNames->'$(TargetDir)%(Identity)')" Condition="Exists('$(TargetDir)%(Identity)')" />

            <DependencyDll Include="$(TargetDir)*.dll" Exclude="$(TargetPath);@(HostDll->'$(TargetDir)%(Filename)%(Extension)');@(PlatformDependentDll);@(UselessDll)" />
        </ItemGroup>

        <Copy SourceFiles="@(OwnDll)" DestinationFolder="$(ModuleDir)" Condition="'$(ModuleDir)' != '' and '$(HostDir)' != ''" />
        <Copy SourceFiles="@(DependencyDll)" DestinationFolder="$(ModuleDir)\libs" Condition="'$(ModuleDir)' != '' and '$(HostDir)' != ''" />
        <Copy SourceFiles="@(PlatformDependentDll)" DestinationFolder="$(PlatformLibsDir)" Condition="'$(ModuleDir)' != '' and '$(HostDir)' != ''" />
    </Target>
</Project>
