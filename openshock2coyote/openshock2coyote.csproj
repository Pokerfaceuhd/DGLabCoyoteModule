<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- per-developer paths (ModuleDir/HostDir) - not committed, see local.settings.props.example -->
    <Import Project="local.settings.props" Condition="Exists('local.settings.props')" />

    <PropertyGroup>
        <SingleProject>true</SingleProject>
        <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>openshock2coyote</RootNamespace>
        <Version>0.5.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>

        <Configurations>Release;Debug</Configurations>

        <Platforms>AnyCPU</Platforms>

        <PackageId>openshock2coyote</PackageId>
    </PropertyGroup>

    
    <ItemGroup>
        <PackageReference Include="CircularBuffer" Version="1.4.0" />
        <PackageReference Include="LucHeart.WebsocketLibrary.Flatbuffers" Version="1.2.0" />
        <PackageReference Include="MudBlazor" Version="9.9.0" />
        <PackageReference Include="OpenShock.Desktop.ModuleBase" Version="1.3.1" />
        <PackageReference Include="OpenShock.SDK.CSharp" Version="0.0.45" />
        <PackageReference Include="OpenShock.SDK.CSharp.Live" Version="0.0.45" />
        <PackageReference Include="OpenShock.Serialization.Flatbuffers" Version="2.1.0" />
        <PackageReference Include="Semver" Version="3.0.0" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="SimpleSharpBLE" Version="1.4.0" />
        <PackageReference Include="System.Reactive" Version="7.0.0" />
        <PackageReference Include="Tmds.DBus" Version="0.95.2" />
    </ItemGroup>

    <ItemGroup>
        <_ContentIncludedByDefault Remove="wwwroot\images\Icon.svg" />
        <_ContentIncludedByDefault Remove="wwwroot\images\Icon512.png" />
        <_ContentIncludedByDefault Remove="wwwroot\images\Icon64.png" />
        <_ContentIncludedByDefault Remove="wwwroot\images\IconLoadingSpin.svg" />
        <_ContentIncludedByDefault Remove="wwwroot\images\IconSlowSpin.svg" />
        <_ContentIncludedByDefault Remove="Properties\launchSettings.json" />
    </ItemGroup>

    <ItemGroup>
        <UpToDateCheckInput Remove="Ui\Pages\Authentication\Authenticate.razor" />
        <UpToDateCheckInput Remove="Ui\Pages\Authentication\LoginPart.razor" />
        <UpToDateCheckInput Remove="Ui\Pages\Authentication\NotAuthedLayout.razor" />
        <UpToDateCheckInput Remove="Ui\ErrorHandling\CodeBlock.razor" />
        <UpToDateCheckInput Remove="Ui\ErrorHandling\ContainerWithExceptionHandling.razor" />
        <UpToDateCheckInput Remove="Ui\ErrorHandling\ExceptionView.razor" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Resources\openshock2coyote-Icon.png" />
        <EmbeddedResource Include="Resources\openshock2coyote-Icon.png" />
    </ItemGroup>

    <PropertyGroup>
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    

    <Target Name="CopyOwnDllOnly"
            AfterTargets="Build"
            Condition="'$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">

        <PropertyGroup>
            <IsWindowsBuild Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">true</IsWindowsBuild>
            <IsWindowsBuild Condition="'$(TargetFramework)' != 'net10.0-windows10.0.19041.0'">false</IsWindowsBuild>

            <PlatformRid Condition="'$(IsWindowsBuild)' == 'true'">win-x64</PlatformRid>
            <PlatformRid Condition="'$(IsWindowsBuild)' != 'true'">linux-x64</PlatformRid>

            <PlatformLibsDir>$(ModuleDir)\libs\$(PlatformRid)</PlatformLibsDir>
        </PropertyGroup>

        <Warning
                Text="ModuleDir/HostDir not set - copy local.settings.props.example to local.settings.props and fill in your paths. Skipping local module deployment."
                Condition="'$(ModuleDir)' == '' or '$(HostDir)' == ''" />

        <ItemGroup Condition="'$(ModuleDir)' != '' and '$(HostDir)' != ''">

            <!-- Shared main module DLL: use net10.0 for both platforms -->
            <OwnDll Include="$(TargetPath)"
                    Condition="'$(TargetFramework)' == 'net10.0'" />

            <OwnDll Include="$(TargetDir)$(TargetName).pdb"
                    Condition="'$(TargetFramework)' == 'net10.0' and Exists('$(TargetDir)$(TargetName).pdb')" />

            <!-- Shared dependencies: collect from net10.0 only -->
            <OwnDependencyDll Include="$(TargetDir)System.Reactive.dll"
                              Condition="'$(TargetFramework)' == 'net10.0' and Exists('$(TargetDir)System.Reactive.dll')" />

            <HostDll Include="$(HostDir)\*.dll" />
            
            <PlatformDependentDll Include="$(TargetDir)SimpleSharpBLE.dll"
                                  Condition="Exists('$(TargetDir)SimpleSharpBLE.dll')" />
            
            <!-- Linux -->
            <PlatformDependentDll Include="$(TargetDir)Tmds.DBus.dll"
                                  Condition="'$(IsWindowsBuild)' != 'true'
                          and Exists('$(TargetDir)Tmds.DBus.dll')" />

            <!-- Windows -->
            <PlatformDependentDll Include="$(TargetDir)Microsoft.Windows.SDK.NET.dll"
                                  Condition="'$(IsWindowsBuild)' == 'true'
                          and Exists('$(TargetDir)Microsoft.Windows.SDK.NET.dll')" />

            <!-- Assemblies that must not be bundled -->
            <UselessDll Include="$(TargetDir)Tmds.DBus.dll"
                        Condition="'$(IsWindowsBuild)' == 'true' and Exists('$(TargetDir)Tmds.DBus.dll')" />

            <UselessDll Include="$(TargetDir)WinRT.Runtime.dll"
                        Condition="'$(IsWindowsBuild)' == 'true' and Exists('$(TargetDir)WinRT.Runtime.dll')" />

            <!-- Shared dependencies: only collect from the canonical net10.0 build -->
            <DependencyDll Include="$(TargetDir)*.dll"
                           Condition="'$(TargetFramework)' == 'net10.0'"
                           Exclude="
                            $(TargetPath);
                            $(TargetDir)System.Reactive.dll;
                            $(TargetDir)SimpleSharpBLE.dll;
                            $(TargetDir)Tmds.DBus.dll;
                            $(TargetDir)Microsoft.Windows.SDK.NET.dll;
                            $(TargetDir)WinRT.Runtime.dll;
                            @(HostDll->'$(TargetDir)%(Filename)%(Extension)')
                       " />

            <!-- Native SimpleBLE runtime libraries -->
            <NativeRuntimeFile
                    Include="$(TargetDir)runtimes/$(PlatformRid)/native/*"
                    Condition="Exists('$(TargetDir)runtimes/$(PlatformRid)/native')" />

        </ItemGroup>

        <!-- Remove stale platform-specific DLLs from the shared directory -->
        <Delete
                Files="$(ModuleDir)\libs\Shiny.BluetoothLE.dll;
               $(ModuleDir)\libs\SimpleSharpBLE.dll;
               $(ModuleDir)\libs\Tmds.DBus.dll;
               $(ModuleDir)\libs\Microsoft.Windows.SDK.NET.dll;
               $(ModuleDir)\libs\WinRT.Runtime.dll"
                Condition="'$(ModuleDir)' != '' and '$(HostDir)' != ''" />

        <!-- Copy shared main assembly -->
        <Copy SourceFiles="@(OwnDll)"
              DestinationFolder="$(ModuleDir)"
              Condition="'$(ModuleDir)' != '' and '$(HostDir)' != ''" />

        <!-- Copy shared dependencies -->
        <Copy SourceFiles="@(DependencyDll)"
              DestinationFolder="$(ModuleDir)\libs"
              Condition="'$(ModuleDir)' != '' and '$(HostDir)' != ''" />

        <Copy SourceFiles="@(OwnDependencyDll)"
              DestinationFolder="$(ModuleDir)\libs"
              Condition="'$(ModuleDir)' != '' and '$(HostDir)' != ''" />

        <!-- Copy platform-specific dependencies -->
        <Copy SourceFiles="@(PlatformDependentDll)"
              DestinationFolder="$(PlatformLibsDir)"
              Condition="'$(ModuleDir)' != '' and '$(HostDir)' != ''" />

        <!-- Copy native runtime libraries -->
        <Copy SourceFiles="@(NativeRuntimeFile)"
              DestinationFolder="$(PlatformLibsDir)"
              SkipUnchangedFiles="true"
              Condition="'$(ModuleDir)' != '' and '$(HostDir)' != ''" />
    </Target>
</Project>
